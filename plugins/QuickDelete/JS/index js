const { jsx, jsxs } = revenge.react.ReactJSXRuntime;
const { patcher, jsonStorage, components } = revenge;
const { Design } = revenge.discord.design;
const { AlertActionCreators } = revenge.discord.actions;
const { Logger } = revenge.discord.common.logger;

const settings = jsonStorage.getJsonStorage(
	jsonStorage.pluginStoragePathFor("k1ngop.quick-delete", "storage.json"),
	{ default: { autoConfirmMessage: true, autoConfirmEmbed: true, debug: false }, load: true },
);

const logger = new Logger("QuickDelete");

function text(n, d = 0) {
	if (n == null || d > 6) return "";
	if (typeof n === "string") return n;
	if (Array.isArray(n)) return n.map((c) => text(c, d + 1)).join(" ");
	return n.props ? text(n.props.children, d + 1) : "";
}

function buttons(n, out = [], d = 0) {
	if (n == null || d > 6) return out;
	if (Array.isArray(n)) {
		n.forEach((c) => buttons(c, out, d + 1));
		return out;
	}
	if (n.props) {
		if (typeof n.props.onPress === "function") out.push(n.props);
		buttons(n.props.children, out, d + 1);
	}
	return out;
}

// picks the confirm button: prefers "destructive" variant, else the non-secondary
// button of a plain Yes/No pair (Discord doesn't always style deletes as destructive)
function confirmButton(actions) {
	const list = buttons(actions);
	const destructive = list.find((b) => b.variant === "destructive");
	if (destructive) return destructive.onPress;
	if (list.length === 2)
		return list.find((b) => b.variant !== "secondary" && b.variant !== "tertiary")?.onPress;
}

function SettingsPage() {
	const s = settings.use() ?? settings.cache;
	const set = (k, v) => settings.set({ [k]: v });

	return jsx(components.Page, {
		children: jsxs(Design.TableRowGroup, {
			title: "Settings",
			children: [
				jsx(Design.TableSwitchRow, {
					label: "Messages",
					subLabel: "Deletes messages without confirmation",
					value: s.autoConfirmMessage,
					onValueChange: (v) => set("autoConfirmMessage", v),
				}),
				jsx(Design.TableSwitchRow, {
					label: "Embeds",
					subLabel: "Deletes embeds without confirmation",
					value: s.autoConfirmEmbed,
					onValueChange: (v) => set("autoConfirmEmbed", v),
				}),
				jsx(Design.TableSwitchRow, {
					label: "Debug logging",
					subLabel: "Logs alert data to Debug Logs",
					value: s.debug,
					onValueChange: (v) => set("debug", v),
				}),
			],
		}),
	});
}

let unpatch;

export default plugin({
	start() {
		unpatch = patcher.instead(AlertActionCreators, "openAlert", (args, orig) => {
			const [key, alert] = args;
			const s = settings.cache;
			if (!s.autoConfirmMessage && !s.autoConfirmEmbed) return orig(...args);

			const title = text(alert?.props?.title);
			const isMsg = s.autoConfirmMessage && title === "Delete Message";
			const isEmbed = s.autoConfirmEmbed && title === "Delete Embed";
			if (!isMsg && !isEmbed) return orig(...args);

			const confirm = confirmButton(alert?.props?.actions);
			if (s.debug) logger.log("openAlert", { key, title, isMsg, isEmbed, hasConfirm: !!confirm });
			if (!confirm) return orig(...args);

			confirm();
		});
	},
	stop() {
		unpatch?.();
	},
	SettingsComponent: SettingsPage,
});

